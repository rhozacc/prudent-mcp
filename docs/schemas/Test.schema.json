{
  "$ref": "#/definitions/Test",
  "definitions": {
    "Test": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^test:\\/\\/.+"
        },
        "name": {
          "type": "string"
        },
        "aliases": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        },
        "family": {
          "type": "string"
        },
        "purpose": {
          "type": "string"
        },
        "acceptance_criteria": {
          "type": "string"
        },
        "regulatory_basis": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^regulation:\\/\\/.+"
          },
          "default": []
        },
        "primary_basis": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^regulation:\\/\\/.+"
          }
        },
        "parent": {
          "type": "string",
          "pattern": "^regulation:\\/\\/.+"
        },
        "last_updated": {
          "type": "string",
          "format": "date"
        },
        "applicability": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "status": {
                  "type": "string",
                  "const": "historical"
                },
                "until": {
                  "type": "string",
                  "format": "date"
                },
                "reason": {
                  "type": "string",
                  "minLength": 1
                },
                "replaced_by": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "pattern": "^regulation:\\/\\/.+"
                  }
                }
              },
              "required": [
                "status",
                "until",
                "reason"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "status": {
                  "type": "string",
                  "const": "upcoming"
                },
                "from": {
                  "type": "string",
                  "format": "date"
                },
                "reason": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "status",
                "reason"
              ],
              "additionalProperties": false
            }
          ]
        }
      },
      "required": [
        "id",
        "name",
        "purpose",
        "last_updated"
      ],
      "additionalProperties": false
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#"
}
