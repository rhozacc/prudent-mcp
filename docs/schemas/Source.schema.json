{
  "$ref": "#/definitions/Source",
  "definitions": {
    "Source": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^source:\\/\\/.+"
        },
        "title": {
          "type": "string"
        },
        "framework": {
          "type": "string"
        },
        "document_id": {
          "type": "string"
        },
        "doc_type": {
          "type": "string",
          "enum": [
            "regulation",
            "guideline",
            "guide",
            "consultation",
            "statement",
            "report",
            "other"
          ]
        },
        "status": {
          "type": "string",
          "enum": [
            "current",
            "pending",
            "superseded"
          ]
        },
        "published": {
          "type": "string",
          "format": "date"
        },
        "effective_from": {
          "type": "string",
          "format": "date"
        },
        "verified": {
          "type": "string",
          "format": "date"
        },
        "superseded_by": {
          "type": "string",
          "pattern": "^source:\\/\\/.+"
        },
        "milestones": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "date": {
                "type": "string"
              },
              "event": {
                "type": "string"
              }
            },
            "required": [
              "date",
              "event"
            ],
            "additionalProperties": false
          },
          "default": []
        },
        "url": {
          "type": "string"
        },
        "notes": {
          "type": "string"
        },
        "coverage": {
          "type": "string",
          "enum": [
            "full",
            "partial"
          ]
        },
        "pending_changes": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "title": {
                "type": "string"
              },
              "reference": {
                "type": "string"
              },
              "status": {
                "type": "string",
                "enum": [
                  "announced",
                  "adopted"
                ]
              },
              "effective_from": {
                "type": "string",
                "format": "date"
              },
              "ingested": {
                "type": "boolean"
              },
              "affects": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "affects_ids": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^regulation:\\/\\/.+"
                }
              },
              "note": {
                "type": "string"
              },
              "url": {
                "type": "string"
              }
            },
            "required": [
              "title",
              "status",
              "ingested"
            ],
            "additionalProperties": false
          }
        },
        "citation_style": {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "enum": [
                "eba-gl",
                "ecb-guide",
                "eu-regulation",
                "generic"
              ]
            },
            "short_name": {
              "type": "string"
            },
            "chapters": {
              "type": "object",
              "additionalProperties": {
                "type": "string"
              }
            }
          },
          "required": [
            "kind"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "id",
        "title",
        "framework",
        "document_id",
        "doc_type",
        "status",
        "verified"
      ],
      "additionalProperties": false
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#"
}
